# ─── Copy this file to .env and fill in all values ───────────────────────────
# cp .env.example .env

# ─── Host Network ─────────────────────────────────────────────────────────────
# IP address of the machine running this stack (your server/NAS/PC)
HOST_IP=192.168.1.xxx

# Your local network subnet (used by Gluetun to allow LAN access through VPN)
LOCAL_SUBNET=192.168.1.0/24

# ─── Media Paths ──────────────────────────────────────────────────────────────
# Where your downloaded files land (qBittorrent output folder, etc.)
MEDIA_DOWNLOADS=/your/path/to/downloads

# Where *arr apps move/organize your media library
MEDIA_LIBRARY=/your/path/to/library

# ─── Timezone ─────────────────────────────────────────────────────────────────
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# ─── Plex ─────────────────────────────────────────────────────────────────────
# Get a fresh claim token from https://plex.tv/claim — expires 4 minutes after generation
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx

# ─── VPN (Gluetun) ────────────────────────────────────────────────────────────
# Supported providers: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_PROVIDER=private internet access
OPENVPN_USER=your_vpn_username
OPENVPN_PASSWORD=your_vpn_password
VPN_REGION=US Silicon Valley

# ─── Elasticsearch ────────────────────────────────────────────────────────────
# Set a strong password — used by both elasticsearch and tubearchivist
ELASTIC_PASSWORD=change_me_strong_password

# ─── TubeArchivist ────────────────────────────────────────────────────────────
TA_USERNAME=admin
TA_PASSWORD=change_me_strong_password

# Generate TA_SECRET_KEY:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
TA_SECRET_KEY=change_me_generate_a_random_64_char_hex_string
